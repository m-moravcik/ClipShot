    "Nothing to restore: ClipShot has not changed any macOS screenshot setting." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to restore: ClipShot has not changed any macOS screenshot setting."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie je čo obnoviť: ClipShot nezmenil žiadne nastavenie snímok obrazovky v macOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není co obnovit: ClipShot nezměnil žádné nastavení snímků obrazovky v macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wiederherzustellen: ClipShot hat keine Bildschirmfoto-Einstellung von macOS geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada que restaurar: ClipShot no ha cambiado ningún ajuste de captura de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à restaurer : ClipShot n’a modifié aucun réglage de capture de macOS."
          }
        }
      }
    },
    "Off: the file, and so the clipboard, is ready at once. On: macOS saves the file when the thumbnail disappears, a few seconds later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: the file, and so the clipboard, is ready at once. On: macOS saves the file when the thumbnail disappears, a few seconds later."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuté: súbor, a teda aj schránka, je pripravený hneď. Zapnuté: macOS uloží súbor, až keď miniatúra zmizne, o pár sekúnd."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuto: soubor, a tedy i schránka, je připravený hned. Zapnuto: macOS uloží soubor, až miniatura zmizí, o pár sekund později."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Die Datei und damit die Zwischenablage sind sofort bereit. An: macOS sichert die Datei erst, wenn die Miniatur verschwindet, ein paar Sekunden später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivada: el archivo, y con él el portapapeles, está listo al instante. Activada: macOS guarda el archivo cuando desaparece la miniatura, unos segundos después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivée : le fichier, et donc le presse-papiers, est prêt aussitôt. Activée : macOS enregistre le fichier quand la vignette disparaît, quelques secondes plus tard."
          }
        }
      }
    },
    "Only screenshots taken while ClipShot runs are cleaned up. Rename a screenshot to keep it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only screenshots taken while ClipShot runs are cleaned up. Rename a screenshot to keep it."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upratujú sa len snímky urobené, kým ClipShot beží. Ak snímku premenuješ, zostane."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklízí se jen snímky pořízené, když ClipShot běží. Když snímek přejmenuješ, zůstane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgeräumt werden nur Bildschirmfotos, die bei laufendem ClipShot entstanden sind. Benenne eines um, um es zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se limpian las capturas hechas mientras ClipShot está abierto. Renombra una captura para conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les captures prises pendant que ClipShot tourne sont nettoyées. Renommez une capture pour la garder."
          }
        }
      }
    },
