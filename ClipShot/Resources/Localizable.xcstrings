    "Downloads updates in the background and offers to restart when one is ready. ClipShot never restarts on its own." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads updates in the background and offers to restart when one is ready. ClipShot never restarts on its own."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizácie sťahuje na pozadí a keď je niektorá pripravená, ponúkne reštart. ClipShot sa nikdy nereštartuje sám."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace stahuje na pozadí, a když je některá připravená, nabídne restart. ClipShot se nikdy nerestartuje sám."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Updates im Hintergrund und bietet einen Neustart an, sobald eines bereit ist. ClipShot startet nie von selbst neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga las actualizaciones en segundo plano y ofrece reiniciar cuando hay una lista. ClipShot nunca se reinicia solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge les mises à jour en arrière-plan et propose de redémarrer quand l’une est prête. ClipShot ne redémarre jamais de lui-même."
          }
        }
      }
    },
    "Every new screenshot goes to the clipboard as an image. The file stays where macOS saves it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every new screenshot goes to the clipboard as an image. The file stays where macOS saves it."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá nová snímka ide do schránky ako obrázok. Súbor zostane tam, kam ho macOS uloží."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý nový snímek jde do schránky jako obrázek. Soubor zůstane tam, kam ho macOS uloží."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes neue Bildschirmfoto kommt als Bild in die Zwischenablage. Die Datei bleibt, wo macOS sie sichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada captura nueva va al portapapeles como imagen. El archivo se queda donde lo guarda macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque nouvelle capture va dans le presse-papiers sous forme d’image. Le fichier reste là où macOS l’enregistre."
          }
        }
      }
    },
    "Every screenshot you take goes to the clipboard, ready to paste. macOS still saves the file and shows the thumbnail as usual." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every screenshot you take goes to the clipboard, ready to paste. macOS still saves the file and shows the thumbnail as usual."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá snímka obrazovky ide rovno do schránky, hneď ju môžeš vložiť. macOS pritom uloží súbor a ukáže miniatúru ako vždy."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý snímek obrazovky jde rovnou do schránky, hned ho můžeš vložit. macOS přitom uloží soubor a ukáže miniaturu jako vždy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Bildschirmfoto landet in der Zwischenablage, bereit zum Einfügen. macOS sichert die Datei und zeigt die Miniatur wie gewohnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada captura que hagas va al portapapeles, lista para pegar. macOS sigue guardando el archivo y mostrando la miniatura como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque capture d’écran va dans le presse-papiers, prête à coller. macOS enregistre toujours le fichier et affiche la vignette comme d’habitude."
          }
        }
      }
    },
