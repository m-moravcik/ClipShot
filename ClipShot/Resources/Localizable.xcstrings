    "ClipShot saw a screenshot but could not copy it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot saw a screenshot but could not copy it."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot zachytil snímku, ale nepodarilo sa ju skopírovať."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot zachytil snímek, ale nepodařilo se ho zkopírovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot hat ein Bildschirmfoto erkannt, konnte es aber nicht kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot detectó una captura, pero no pudo copiarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot a repéré une capture, mais n’a pas pu la copier."
          }
        }
      }
    },
    "ClipShot watches the folder where macOS saves screenshots and copies each new one. If that folder is Desktop, Documents or Downloads, macOS asks you once to allow it." : {
      "comment" : "Welcome tour step 2: explains folder access before the button that asks for it",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot watches the folder where macOS saves screenshots and copies each new one. If that folder is Desktop, Documents or Downloads, macOS asks you once to allow it."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot sleduje priečinok, kam macOS ukladá snímky obrazovky, a každú novú skopíruje. Ak je to Plocha, Dokumenty alebo Stiahnuté, macOS sa ťa raz opýta na povolenie."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot sleduje složku, kam macOS ukládá snímky obrazovky, a každý nový zkopíruje. Pokud je to Plocha, Dokumenty nebo Stažené soubory, macOS se tě jednou zeptá na povolení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot beobachtet den Ordner, in dem macOS Bildschirmfotos sichert, und kopiert jedes neue. Ist es Schreibtisch, Dokumente oder Downloads, fragt macOS dich einmal um Erlaubnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot vigila la carpeta donde macOS guarda las capturas y copia cada una nueva. Si es Escritorio, Documentos o Descargas, macOS te pedirá permiso una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot surveille le dossier où macOS enregistre les captures d’écran et copie chaque nouvelle. S’il s’agit du Bureau, de Documents ou de Téléchargements, macOS vous demandera une fois l’autorisation."
          }
        }
      }
    },
    "ClipShot, copying on" : {
