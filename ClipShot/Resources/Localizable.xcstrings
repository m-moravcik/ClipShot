    "Screenshots are set to PDF. While the thumbnail is on, macOS saves no PDF file, so there is nothing to copy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots are set to PDF. While the thumbnail is on, macOS saves no PDF file, so there is nothing to copy."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky sú nastavené na PDF. Kým je miniatúra zapnutá, macOS PDF súbor neuloží, takže nie je čo kopírovať."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky jsou nastavené na PDF. Dokud je miniatura zapnutá, macOS soubor PDF neuloží, takže není co kopírovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos sind auf PDF eingestellt. Solange die Miniatur an ist, sichert macOS keine PDF-Datei, also gibt es nichts zu kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas están en PDF. Con la miniatura activada, macOS no guarda ningún PDF, así que no hay nada que copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures sont réglées sur PDF. Tant que la vignette est activée, macOS n’enregistre aucun PDF, il n’y a donc rien à copier."
          }
        }
      }
    },
    "Screenshots go to another app instead of a file, so ClipShot has nothing to copy." : {
      "comment" : "The macOS screenshot destination is an app such as Preview or Mail",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots go to another app instead of a file, so ClipShot has nothing to copy."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky idú do inej aplikácie namiesto súboru, takže ClipShot nemá čo kopírovať."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky jdou do jiné aplikace místo do souboru, takže ClipShot nemá co kopírovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos gehen an eine andere App statt in eine Datei, daher hat ClipShot nichts zu kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas van a otra app en lugar de a un archivo, así que ClipShot no tiene nada que copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures vont dans une autre app au lieu d’un fichier, ClipShot n’a donc rien à copier."
          }
        }
      }
    },
    "Screenshots go to the clipboard only, so macOS saves no file and ClipShot has nothing to copy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots go to the clipboard only, so macOS saves no file and ClipShot has nothing to copy."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky idú len do schránky, takže macOS neuloží súbor a ClipShot nemá čo kopírovať."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky jdou jen do schránky, takže macOS neuloží soubor a ClipShot nemá co kopírovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos gehen nur in die Zwischenablage, also sichert macOS keine Datei und ClipShot hat nichts zu kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas van solo al portapapeles, así que macOS no guarda ningún archivo y ClipShot no tiene nada que copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures vont seulement dans le presse-papiers : macOS n’enregistre aucun fichier et ClipShot n’a rien à copier."
          }
        }
      }
    },
    "Screenshots now go to “%@”. Retention is paused until you check what it would move." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots now go to “%@”. Retention is paused until you check what it would move."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky teraz idú do „%@“. Upratovanie je pozastavené, kým neskontroluješ, čo by presunulo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky teď jdou do „%@“. Úklid je pozastavený, dokud nezkontroluješ, co by přesunul."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos landen jetzt in „%@“. Aufräumen ist pausiert, bis du prüfst, was es verschieben würde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas van ahora a «%@». La limpieza está en pausa hasta que revises qué movería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures vont désormais dans « %@ ». Le nettoyage est en pause jusqu’à ce que vous vérifiiez ce qu’il déplacerait."
          }
        }
      }
    },
