    "ClipShot did not see these being taken. They go to the Trash with the next cleanup." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot did not see these being taken. They go to the Trash with the next cleanup."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot nevidel, ako vznikli. Do Koša pôjdu pri ďalšom upratovaní."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipShot neviděl, jak vznikly. Do Koše půjdou při dalším úklidu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
