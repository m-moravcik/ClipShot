    "Copies every screenshot to the clipboard and keeps the file and the thumbnail. Can move old screenshots to the Trash." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies every screenshot to the clipboard and keeps the file and the thumbnail. Can move old screenshots to the Trash."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každú snímku obrazovky skopíruje do schránky a nechá súbor aj miniatúru. Staré snímky vie presúvať do Koša."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý snímek obrazovky zkopíruje do schránky a nechá soubor i miniaturu. Staré snímky umí přesouvat do Koše."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert jedes Bildschirmfoto in die Zwischenablage und behält Datei und Miniatur. Kann alte Bildschirmfotos in den Papierkorb legen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia cada captura de pantalla al portapapeles y conserva el archivo y la miniatura. Puede mover las capturas antiguas a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie chaque capture d’écran dans le presse-papiers en gardant le fichier et la vignette. Peut placer les anciennes captures dans la Corbeille."
          }
        }
      }
    },
